# Copy to relay.env ON THE SERVER. Never commit the real file.
RELAY_SECRET=                 # >=32 chars; the same value goes into Vercel as FAMILY_MAIL_RELAY_SECRET
BREVO_API_KEY=                # Brevo → SMTP & API → API keys
ALLOWED_LINK_PREFIX=https://kartel.org.uk/api/family-auth/verify?token=
MAIL_FROM=no-reply@mail.kartel.org.uk
MAIL_FROM_NAME=KARTEL
LINK_TTL_MINUTES=10
PORT=8787
