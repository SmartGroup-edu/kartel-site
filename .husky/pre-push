#!/usr/bin/env sh
# Pre-push gate before pushing (typically to main).
# lint + typecheck are fast. The snapshot tests (tests/*.test.mjs) read the
# prerendered build output (.next/server/app/*), so they are only meaningful
# after a build — hence build runs here too. This is the gate that would have
# caught CI going red on 2026-06-27 (sitemap/sw tests vs. hidden /family):
# typecheck alone missed it because it was a snapshot-content mismatch, not a
# type error. Cost: each push runs a Next build. To skip on a throwaway push:
#   git push --no-verify
set -e
# Node parity (2026-11-16): local green must mean CI green. CI and Vercel use
# the major in .nvmrc; a newer local Node can run code the CI Node cannot
# (PR #58 went red: Node 24 strips .ts types, the old CI Node 20 did not).
want="$(tr -d ' \nv' < .nvmrc)"
have="$(node -p 'process.versions.node.split(".")[0]')"
if [ "$have" = "$want" ]; then
  run_node() { "$@"; }
else
  echo "→ pre-push: local Node $have ≠ .nvmrc $want — running the gate on Node $want via npx"
  run_node() { npx -y -p "node@$want" -- "$@"; }
fi
echo "→ pre-push: registry-sync (public↔private kartel-core parity)"
run_node npm run registry:check
echo "→ pre-push: lint"
run_node npm run lint
echo "→ pre-push: typecheck"
run_node npx tsc --noEmit
echo "→ pre-push: build"
run_node npm run build
echo "→ pre-push: test"
run_node npm test
