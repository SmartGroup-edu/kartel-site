# kartel-site — environment contract
#
# The public site needs NONE of these. Everything below belongs to the gated Family Heritage area
# and the operations console, and is read lazily, so the build and all public routes work without
# them. See docs/standalone-auth-design.md.
#
# STANDALONE AUTH (R0 decision 2026-11-14): Keycloak is retired. There is no OIDC_* block any more.
# The email IS the identity — the session subject is the lowercased email — so there is no user
# table: the allowlist below is the user list.

# ── Master switch ──────────────────────────────────────────────────────────
# The gate is inert unless this is exactly "on". Unset it to roll the whole feature back.
FAMILY_GATE=on

# ── Session ────────────────────────────────────────────────────────────────
# >=32 chars. Rotating it signs every viewer out and invalidates outstanding sign-in links
# (the link key is derived from it).
FAMILY_SESSION_SECRET=
# The session cookie name is fixed in code (app/lib/family-cookie.mjs): __Host-kartel_family_session in
# production, kartel_family_session in dev. FAMILY_SESSION_COOKIE is no longer read — delete it from Vercel.
FAMILY_SESSION_MAX_AGE=28800          # 8h
# Every family cookie is host-only (QA-156 L2). The console gets its own cookie through the 60-second
# hand-off (/api/family-auth/console-handoff). FAMILY_COOKIE_DOMAIN is no longer read — delete it from Vercel.

# ── Passkeys ───────────────────────────────────────────────────────────────
# Dormant unless exactly "on". The family-os service also needs FAMILY_PASSKEY_RP_ID and
# FAMILY_PASSKEY_ORIGINS (family-os/README.md); without them every passkey route answers 404.
FAMILY_PASSKEYS=on

# ── Sign-in link ───────────────────────────────────────────────────────────
FAMILY_LINK_TTL=600                   # 10 min
FAMILY_LINK_NONCE_COOKIE=kartel_family_link
FAMILY_SITE_ORIGIN=https://kartel.org.uk

# ── Mail (via kartel-mail-relay on Hetzner — see relay/README.md) ──────────
# Brevo blocks API calls from unlisted IPs and Vercel has no fixed IP, so the site does NOT hold
# the Brevo key. It signs a request to the relay; the relay holds the key, sender and template.
FAMILY_MAIL_RELAY_URL=https://mail-relay.kartel.org.uk
FAMILY_MAIL_RELAY_SECRET=             # same value as RELAY_SECRET in relay.env, >=32 chars

# ── Who may get in ─────────────────────────────────────────────────────────
# Admins: reach /console and are always approved for /family. Comma-separated, lowercased.
# Without it /console closes to everyone.
FAMILY_ADMIN_EMAILS=

# Founder-seeded family allowlist. An address here may request a sign-in link.
# Runtime add/revoke lives in the Edge Config item `familyAccessEmails`.
FAMILY_APPROVED_EMAILS=

# ── Edge Config ────────────────────────────────────────────────────────────
# Provides `familyAccessEmails`.
EDGE_CONFIG=

# ── NOT a variable: rate limiting ──────────────────────────────────────────
# /api/family-auth/request emails a caller-supplied address and CANNOT be rate limited in
# application code here — no KV, no database, and in-memory counters do not survive serverless
# invocations. A Vercel Firewall rule on that path is a PRECONDITION of going live:
# suggested 5 requests per IP per 10 minutes and 3 per address per hour.
